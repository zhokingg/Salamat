<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Salamat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<key>CFBundleName</key>
	<string>salamat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Deep link back into the app from a Supabase auth email.
	     Confirmation and password-recovery links land on a URL the project
	     hands out; without a scheme registered here iOS had nowhere to send
	     them, so the link opened a browser and died there. supabase_flutter
	     picks the URI up on its own (app_links is one of its dependencies)
	     and exchanges the PKCE `code` in it; the app only has to own the
	     scheme. The matching Redirect URL must also be allow-listed in the
	     Supabase dashboard, or GoTrue refuses to send people to it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>kg.salamat.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kg.salamat.app</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Exempt from the export-compliance questionnaire: the app makes no use
	     of cryptography of its own. Everything it sends goes over HTTPS via
	     the system's own stack (Supabase, RevenueCat, the Edge Functions),
	     which is the standard exemption. Declaring it here stops App Store
	     Connect asking on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Salamat needs camera access to photograph your meals and recognise dishes for your food diary.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Salamat needs the microphone so you can say what you ate instead of typing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Salamat turns what you say into text on this device to add the dishes to your food diary.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait only. Every screen was laid out for a phone held upright and
	     none has ever been looked at sideways: the calorie ring, the BMI scale
	     and the onboarding steps all assume the tall axis. Declared here rather
	     than through SystemChrome.setPreferredOrientations because the system
	     reads this before the first frame — there is no window in which the app
	     could rotate before Dart has run.
	     Upside-down is left out on purpose: Face ID iPhones do not offer it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
